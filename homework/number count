count = 0
total = 0
largest = None
smallest = None
even_count = 0
odd_count = 0

# bonus
over_100 = 0
negative_count = 0
small_total = 0
small_count = 0

print("Please enter a number (0 to finish):")

while True:
    number = int(input())

    if number == 0:
        break

    count += 1
    total += number

    if largest is None or number > largest:
        largest = number
    if smallest is None or number < smallest:
        smallest = number

    if number % 2 == 0:
        even_count += 1
    else:
        odd_count += 1

    if number > 100:
        over_100 += 1
    if number < 0:
        negative_count += 1
    if number <= 100:
        small_total += number
        small_count += 1

if count == 0:
    print("You didn't enter any numbers.")
else:
    print(f"\nYou entered {count} numbers.\n")
    print(f"Sum: {total}")
    print(f"Average: {total / count:.1f}")
    print(f"Largest: {largest}")
    print(f"Smallest: {smallest}")
    print(f"Even numbers: {even_count}")
    print(f"Odd numbers: {odd_count}")
    print(f"Greater than 100: {over_100}")
    print(f"Negative numbers: {negative_count}")
    if small_count > 0:
        print(f"Average of numbers <= 100: {small_total / small_count:.1f}")